# Copier ce fichier en .env (jamais versionné) avant de lancer docker compose.

# Endpoint de réception. En local hors Docker : http://127.0.0.1:8000/metrics
# Avec docker compose, l'agent joint l'API par son nom de service.
METRICS_ENDPOINT=http://api:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5
